# Environment
NODE_ENV=development
PORT=5001

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/smart_queue
REDIS_URL=redis://127.0.0.1:6379

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# QR Check-in
QR_SECRET=your-qr-secret-key-change-in-production
CHECKIN_OPEN_MINUTES_BEFORE=30
CHECKIN_EXPIRE_MINUTES_AFTER=15

# Frontend
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Email (Optional - SMTP configuration)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS & WhatsApp (Optional - Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Maps (Required for location picker)
VITE_GOOGLE_MAPS_API_KEY=AIzaSyChCC0kWlgXWmUzYahyTIVL2--qWGaMaJ8y

# Cron Jobs
# Auto-delete finished appointments (in days)
APPOINTMENT_DELETE_FINISHED_AFTER_DAYS=1
# Private appointment requirement uploads are stored under backend/uploads by default.
# Set this to a persistent local directory when deploying.
APPOINTMENT_UPLOAD_DIR=

# Logs
LOG_LEVEL=info
